            const email = (document.getElementById('regBizEmail').value || '').trim().toLowerCase();
            const pin = (document.getElementById('regBizPin').value || '').trim() || '1234';

            if (!name || !code) return alert("Business Name and Store Code are required.");
            if (!email || !email.includes('@')) return alert("A valid Owner Email is required.");

            try {
                const check = await getDoc(doc(db, "shops", code));
                if (check.exists()) return alert(`❌ Store code "${code}" is already taken.`);

                await setDoc(doc(db, "shops", code), { name, code, phone, email, pin, plan: "trial", trialExpiresAt: Date.now() + 1209600000, createdAt: Date.now() });
                currentBizId = code;
                localStorage.setItem('starbite_active_biz_id', code);
                window.checkAuthDisplay();
                window.initBusinessListeners();
                alert(`🎉 Business "${name}" registered with 14 Days Free Trial!`);
