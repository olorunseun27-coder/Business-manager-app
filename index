            try {
                const snap = await getDoc(doc(db, "shops", code));
                if (!snap.exists()) {
                    if (code === 'STARBITE') {
                        await setDoc(doc(db, "shops", "STARBITE"), { name: "Starbite Shop", code: "STARBITE", pin: pin || "1234", plan: "trial", trialExpiresAt: Date.now() + 1209600000, createdAt: Date.now() });
