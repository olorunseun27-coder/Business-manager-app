        window.logoutBusiness = () => {
            if(!confirm("Log out and return to front login screen?")) return;
            localStorage.removeItem('starbite_active_biz_id');
            currentBizId = '';
            if (unsubProducts) unsubProducts();
            if (unsubSales) unsubSales();
            if (unsubDebtors) unsubDebtors();
            if (unsubTrash) unsubTrash();
            if (unsubShopMeta) unsubShopMeta();
