                        return alert(`❌ Business code "${code}" does not exist. Click 'Create Shop' to register.`);
                    }
                } else {
                    const data = snap.data();
                    if (pin !== String(data.pin || '1234').trim()) {
                        return alert("❌ Incorrect Security PIN for " + code);
                    }
                }

                currentBizId = code;
                localStorage.setItem('starbite_active_biz_id', code);
                window.checkAuthDisplay();
                window.initBusinessListeners();
            } catch(e) { alert("Login failed: " + e.message); }
        };

        window.registerBusiness = async () => {
            const name = (document.getElementById('regBizName').value || '').trim();
            const code = (document.getElementById('regBizCode').value || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');
