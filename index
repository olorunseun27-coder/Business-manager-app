        };

        window.openEmailForgotPinModal = () => {
            document.getElementById('fpEmailBizCode').value = (document.getElementById('loginBizCode').value || '').trim().toUpperCase();
            document.getElementById('fp-email-step-1').style.display = 'block';
            document.getElementById('fp-email-step-2').style.display = 'none';
            document.getElementById('mod-email-forgot-pin').style.display = 'flex';
        };

        window.sendEmailOtpForPinReset = async () => {
            const code = (document.getElementById('fpEmailBizCode').value || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');
            if (!code) return alert("Please enter Store Code.");

            const snap = await getDoc(doc(db, "shops", code));
            if (!snap.exists()) return alert("Store Code not found.");
            const email = snap.data().email;
            if (!email) return alert("No email found for this shop.");

            const otp = String(Math.floor(100000 + Math.random() * 900000));
            await updateDoc(doc(db, "shops", code), { recoveryOtp: otp, recoveryExpiresAt: Date.now() + 600000 });

            await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, { to_email: email, shop_name: snap.data().name || code, store_code: code, otp_code: otp });
            document.getElementById('fpMaskedEmail').innerText = email;
            document.getElementById('fp-email-step-1').style.display = 'none';
            document.getElementById('fp-email-step-2').style.display = 'block';
            alert("Code sent to your email!");
        };

        window.verifyEmailOtpAndSetNewPin = async () => {
            const otp = (document.getElementById('fpEmailOtpInput').value || '').trim();
            const pin = (document.getElementById('fpEmailNewPin').value || '').trim();
            const code = (document.getElementById('fpEmailBizCode').value || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');

            const snap = await getDoc(doc(db, "shops", code));
            const data = snap.data();
            if (data.recoveryOtp !== otp || Date.now() > data.recoveryExpiresAt) return alert("Invalid or expired code.");

            await updateDoc(doc(db, "shops", code), { pin, recoveryOtp: null, recoveryExpiresAt: null });
            alert("✅ New PIN saved! You can now log in.");
            closeModals();
            document.getElementById('loginBizCode').value = code;
            document.getElementById('loginBizPin').value = pin;
        };

        window.copyOwnerAccount = () => {
            const acc = livePaymentConfig.accountNumber;
            navigator.clipboard.writeText(acc).then(() => alert(`Copied account: ${acc}`)).catch(()=>prompt("Copy:", acc));
        };

        window.sendPaymentReceiptWhatsApp = () => {
            const price = Number(livePaymentConfig.premiumPrice || 5000).toLocaleString();
            let msg = `*PAYMENT RECEIPT*\n🏪 Store: ${currentShopData?.name || currentBizId}\n🔑 Code: ${currentBizId}\n💰 Amount: ₦${price}\nTransferred to ${livePaymentConfig.bankName}. Please activate my Premium!`;
            let phone = (livePaymentConfig.whatsappNumber || '').replace(/\D/g, '');
            if (!phone.startsWith('234')) phone = '234' + phone;
            window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(msg)}`, '_blank');
        };

        window.updatePlanUI = (shopData) => {
            currentShopData = shopData;
            const isPrem = shopData.plan === 'premium' && (!shopData.subscriptionExpiresAt || shopData.subscriptionExpiresAt > Date.now());
            window.currentPlan = isPrem ? 'premium' : 'trial';

            document.getElementById('planBadge').innerText = isPrem ? '👑 Premium Plan' : '⭐ Plan: Free Trial';
            document.getElementById('trialBanner').style.display = isPrem ? 'none' : 'flex';
        };

        window.toggleStaffRole = async () => {
            if (!isStaffRole) {
                isStaffRole = true;
                localStorage.setItem('starbite_is_staff', 'true');
                document.body.classList.add('is-staff');
                document.getElementById('roleBadge').innerText = '👷 Worker Mode';
            } else {
                const pin = prompt("Enter PIN to unlock Admin:");
                if (pin === String(currentShopData?.pin || '1234')) {
                    isStaffRole = false;
                    localStorage.setItem('starbite_is_staff', 'false');
                    document.body.classList.remove('is-staff');
                    document.getElementById('roleBadge').innerText = '👑 Admin';
                } else alert("Incorrect PIN.");
            }
            window.syncMarketFrame();
        };

        window.initBusinessListeners = () => {
            if (!currentBizId) return;

            document.getElementById('topShopName').innerText = currentBizId;
            unsubShopMeta = onSnapshot(doc(db, "shops", currentBizId), s => { if(s.exists()) window.updatePlanUI(s.data()); });

            unsubProducts = onSnapshot(collection(db, "shops", currentBizId, "products"), snap => {
                window.products = snap.docs.filter(d => d.id !== '_backup').map(d => ({ id: d.id, ...d.data() }));
                filteredProducts = window.products.filter(p => p.name);
                window.renderShopProducts();
                window.renderStock();
                window.renderDash();
                window.renderQuickTapGrid();
            });

            unsubSales = onSnapshot(query(collection(db, "shops", currentBizId, "sales"), orderBy("date", "desc"), limit(100)), snap => {
                sales = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                window.renderShopHistory();
                window.renderDash();
            });

            unsubDebtors = onSnapshot(collection(db, "shops", currentBizId, "debtors"), snap => {
                debtors = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                window.renderDebtors();
                window.renderDash();
            });

            unsubMarket = onSnapshot(doc(db, "shops", currentBizId, "market", "main_store"), snap => {
                if(snap.exists()) {
                    marketData = snap.data();
                    window.renderDash();
                }
            });
        };

        // Dash
        window.renderDash = () => {
            const today = new Date().toISOString().split('T')[0];
            const todayCash = sales.filter(s => s.date && s.date.startsWith(today) && (s.type === 'Cash' || s.type === 'Debt Payment')).reduce((a, b) => a + Number(b.total || 0), 0);
            const totalOwed = debtors.reduce((a,b) => a + (b.totalDebt - (b.payments||[]).reduce((x,y)=>x+y.amount,0)), 0);
            
            let totalBought = 0;
            (marketData.transactions || []).forEach(t => (t.items || []).forEach(i => totalBought += (Number(i.qty || 0) * (Number(i.packQty) || 1))));
            let totalSold = 0;
            sales.forEach(s => (s.items || []).forEach(si => totalSold += Number(si.qty || 0)));

            document.getElementById('d-today').innerText = "₦" + todayCash.toLocaleString();
            document.getElementById('d-owed').innerText = "₦" + totalOwed.toLocaleString();
            document.getElementById('d-mkt-bought').innerText = totalBought.toLocaleString() + " pcs";
            document.getElementById('d-mkt-sold').innerText = totalSold.toLocaleString() + " pcs";
            document.getElementById('d-stock').innerText = filteredProducts.filter(p => (p.stock || 0) <= 5).length;
        };

        // POS Sell & Cart
        window.renderShopProducts = () => {
            const q = document.getElementById('search').value.toLowerCase();
            const div = document.getElementById('prodList'); div.innerHTML = '';
            filteredProducts.forEach((p, i) => {
                if(p.name.toLowerCase().includes(q)) {
                    div.innerHTML += `<div onclick="window.selProd(${i})" style="padding:10px; border-bottom:1px solid #eee; cursor:pointer; display:flex; justify-content:space-between;">
                        <div><b>${p.name}</b> <small style="color:#666;">(Stock: ${p.stock || 0})</small></div><span>₦${p.price}</span>
                    </div>`;
                }
            });
        };
        window.selProd = i => { document.getElementById('selIndex').value = i; document.getElementById('qty').focus(); };

        window.addToCart = () => {
            const idx = parseInt(document.getElementById('selIndex').value);
            const qty = parseInt(document.getElementById('qty').value);
            if(isNaN(idx) || !qty) return;
            const p = filteredProducts[idx];
            if(qty > (p.stock || 0)) return alert("Not enough shop stock available!");

            const exist = cart.find(c => c.id === p.id);
            if(exist) { exist.qty += qty; exist.sub = exist.price * exist.qty; }
            else cart.push({ ...p, qty, sub: p.price * qty });
            window.renderCart();
            document.getElementById('qty').value = '';
        };

        window.renderCart = () => {
            const div = document.getElementById('cartList'); div.innerHTML = ''; let total = 0;
            cart.forEach((c, i) => { 
                total += c.sub; 
                div.innerHTML += `<div style="display:flex; justify-content:space-between; padding:5px; border-bottom:1px solid #eee;">
                    <span>${c.name} (x${c.qty})</span>
                    <div><button class="btn-blue btn-mini" onclick="window.modQty(${i}, -1)">-</button><button class="btn-blue btn-mini" onclick="window.modQty(${i}, 1)">+</button> ₦${c.sub}</div>
                </div>`; 
            });
            document.getElementById('cartTotal').innerText = total.toLocaleString();
        };

        window.modQty = (i, delta) => {
            cart[i].qty += delta;
            if(cart[i].qty <= 0) cart.splice(i, 1);
            else cart[i].sub = cart[i].price * cart[i].qty;
            window.renderCart();
        };

        window.calcChange = () => {
            const total = parseInt(document.getElementById('cartTotal').innerText.replace(/,/g,'')) || 0;
            const pay = parseInt(document.getElementById('payInput').value) || 0;
            document.getElementById('changeTxt').innerText = "Change: ₦" + (pay > total ? pay - total : 0).toLocaleString();
        };

        window.checkout = async (type) => {
            if(!cart.length) return;
            for(const c of cart) {
                await updateDoc(doc(db, "shops", currentBizId, "products", c.id), { stock: increment(-c.qty) });
            }
            const total = cart.reduce((a,b)=>a+b.sub,0);
            const items = cart.map(c=>({ name: c.name, qty: c.qty, price: c.price, sub: c.sub }));
            const desc = cart.map(c=>`${c.name}(x${c.qty})`).join(', ');

            if(type === 'cash') {
                await addDoc(collection(db, "shops", currentBizId, "sales"), { date: new Date().toISOString(), desc, items, total, type: 'Cash', soldBy: USER_NAME });
            } else {
                const name = document.getElementById('c-name').value;
                await addDoc(collection(db, "shops", currentBizId, "debtors"), { name, phone: document.getElementById('c-phone').value, desc, totalDebt: total, payments: [], date: new Date().toISOString() });
                await addDoc(collection(db, "shops", currentBizId, "sales"), { date: new Date().toISOString(), desc: `Credit: ${name}`, items, total, type: 'Credit', soldBy: USER_NAME });
                closeModals();
            }
            cart = [];
            window.renderCart();
            alert("Sale recorded!");
        };

        // Stock Tab with Eggs and Freezers
        window.renderStock = () => {
            const div = document.getElementById('stockList'); if(!div) return;
            div.innerHTML = '';
            filteredProducts.forEach(p => {
                const isEgg = (p.name || '').toLowerCase().includes('egg');
                div.innerHTML += `<div class="card" style="padding:10px; margin-bottom:8px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div><b>${p.name}</b><br><small>Available: ${p.stock || 0} pcs | ₦${p.price}</small></div>
                        <div style="display:flex; gap:4px;">
                            ${isEgg ? `<button class="btn-orange btn-tbl" onclick="window.useEggCrate('${p.id}')">🥚 Use Crate</button>` : `<button class="btn-blue btn-tbl" onclick="window.transferToFreezer('${p.id}')">❄️ Freezer</button>`}
                            <button class="btn-green btn-tbl admin-only" onclick="window.addStock('${p.id}')">+ Stock</button>
                        </div>
                    </div>
                </div>`;
            });
        };

        window.addStock = async (id) => {
            const n = prompt("Add quantity (pieces):");
            if(n && !isNaN(parseInt(n))) {
                await updateDoc(doc(db, "shops", currentBizId, "products", id), { stock: increment(parseInt(n)) });
            }
        };

        window.transferToFreezer = async (id) => {
            const p = window.products.find(x => x.id === id);
            const packs = prompt(`Packs of ${p.name} to move into freezer?`, "1");
            if(packs && !isNaN(parseInt(packs))) {
                const itemsPerPack = p.itemsPerPack || 12;
                await updateDoc(doc(db, "shops", currentBizId, "products", id), {
                    stock: increment(-(parseInt(packs) * itemsPerPack)),
                    freezerPacks: increment(parseInt(packs))
                });
                alert("Moved to freezer!");
            }
        };

        window.useEggCrate = async (id) => {
            const crates = prompt("How many crates were used?", "1");
            if(crates && !isNaN(parseInt(crates))) {
                await updateDoc(doc(db, "shops", currentBizId, "products", id), { stock: increment(-(parseInt(crates) * 30)) });
                alert("Egg crate deducted!");
            }
        };

        window.renderQuickTapGrid = () => {
            const grid = document.getElementById('quickTapGrid'); if(!grid) return;
            grid.innerHTML = '';
            filteredProducts.filter(p => (p.freezerPacks || 0) > 0).forEach(p => {
                grid.innerHTML += `<button class="btn-blue" style="font-size:11px; padding:6px 2px; margin:0;" onclick="window.selProd(${filteredProducts.indexOf(p)}); document.getElementById('qty').value=1; window.addToCart();">${p.name}</button>`;
            });
        };

        window.renderDebtors = () => {
            const q = document.getElementById('debtSearch')?.value.toLowerCase() || '';
            const tbody = document.getElementById('debtTableBody');
            tbody.innerHTML = debtors.filter(d => d.name.toLowerCase().includes(q)).map(d => {
                const paid = (d.payments || []).reduce((a,b)=>a+b.amount,0);
                const rem = d.totalDebt - paid;
                return `<tr>
                    <td><b>${d.name}</b><br><small>${d.desc}</small></td>
                    <td class="admin-only">₦${d.totalDebt}</td>
                    <td class="admin-only text-green">₦${paid}</td>
                    <td class="admin-only text-red">₦${rem}</td>
                    <td><span class="badge ${rem<=0?'bg-full':'bg-over'}">${rem<=0?'Paid':'Owed'}</span></td>
                    <td><button class="btn-green btn-tbl" onclick="window.payDebt('${d.id}')">Pay</button></td>
                </tr>`;
            }).join('');
        };

        window.payDebt = id => {
            const amt = prompt("Amount received:");
            if(amt && !isNaN(parseInt(amt))) {
                const d = debtors.find(x => x.id === id);
                updateDoc(doc(db, "shops", currentBizId, "debtors", id), {
                    payments: [...(d.payments||[]), { amount: parseInt(amt), date: new Date().toISOString() }]
                });
            }
        };

        window.renderShopHistory = () => {
            const div = document.getElementById('mainHistList'); if(!div) return;
            div.innerHTML = sales.map(s => `<div style="padding:8px; border-bottom:1px solid #eee;">
                <b>₦${s.total}</b> - <small>${s.desc} (${s.type})</small>
            </div>`).join('');
        };

        window.genReport = (type) => {
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF();
            pdf.text("STARBITE SALES REPORT", 14, 15);
            pdf.autoTable({
                head: [['Date', 'Description', 'Type', 'Total']],
                body: sales.map(s => [new Date(s.date).toLocaleDateString(), s.desc, s.type, "₦" + Number(s.total || 0).toLocaleString()])
            });
            pdf.save(`sales_report_${type}.pdf`);
        };

        window.checkAuthDisplay();
        if (currentBizId) window.initBusinessListeners();
    </script>
</body>
</html>
