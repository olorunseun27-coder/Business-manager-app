        window.loginBusiness = async () => {
            const code = (document.getElementById('loginBizCode').value || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');
            const pin = (document.getElementById('loginBizPin').value || '').trim();

            if (!code) return alert("Please enter your Business Code.");
